<view class="page"><view class="card profile"><view class="avatar">{{user.name ? user.name.slice(0,1) : 'Z'}}</view><view class="title">{{user.name || user.username || '用户'}}</view><view class="muted">{{user.route || '未绑定线路'}}</view><view class="muted">默认车辆：{{user.vehicle || '未绑定'}}</view></view><view class="card"><view class="setting" bindtap="changePassword">修改密码</view><view class="setting danger" bindtap="logout">退出登录</view></view></view>
