<view class="page"><view class="card"><view class="section-title">今日配送</view><view class="route">{{dispatchRoute || '未选择线路'}}</view><view class="muted">{{user.vehicle}}</view></view><view wx:if="{{!stores.length}}" class="card muted">今日暂无运单</view><view wx:for="{{stores}}" wx:key="id" class="card store"><text class="store-no">{{index + 1}}</text><text class="store-name">{{item.displayName || item.name}}</text><text wx:if="{{item.isNew}}" class="new-tag">⚠ 新增</text></view></view>