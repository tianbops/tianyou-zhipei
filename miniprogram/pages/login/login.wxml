<view class="page login-page">
  <view class="login-head">
    <image class="logo" src="/assets/logo.png" mode="aspectFit" />
    <view class="title">智配 One</view>
    <view class="muted">登录配送工作台</view>
  </view>
  <view class="card">
    <input class="input" value="{{username}}" placeholder="账号" bindinput="onUsername" />
    <input class="input" value="{{password}}" password placeholder="密码" bindinput="onPassword" />
    <button class="button primary" loading="{{loading}}" disabled="{{loading}}" bindtap="login">登录</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
</view>
