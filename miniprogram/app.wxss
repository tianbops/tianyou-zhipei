page{background:#05070A;color:#fff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;box-sizing:border-box}view,text,button,input,textarea{box-sizing:border-box}.page{min-height:100vh;padding:24rpx 32rpx 48rpx}.card{background:#18212B;border:1rpx solid rgba(255,255,255,.04);border-radius:28rpx;padding:28rpx;margin-bottom:24rpx}.title{font-size:40rpx;font-weight:700}.muted{color:#B8C2CC}.primary{background:#2457A6;color:#fff;border-radius:22rpx}.danger{color:#FFB020}.button{height:96rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:600}.input{height:92rpx;background:#05070A;border:1rpx solid rgba(255,255,255,.12);border-radius:20rpx;padding:0 24rpx;color:#fff;margin-bottom:20rpx}.nav-row{display:flex;gap:18rpx}.nav-item{flex:1;text-align:center;padding:24rpx 8rpx;background:#18212B;border-radius:22rpx;font-size:28rpx}.section-title{font-size:32rpx;font-weight:700;margin-bottom:20rpx}
